#!/bin/sh
set -eu

app_dir="${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
export APPDIR="$app_dir"

if [ -d "$app_dir/apprun-hooks" ]; then
  for hook in "$app_dir"/apprun-hooks/*.sh; do
    if [ -r "$hook" ]; then
      . "$hook"
    fi
  done
fi

if [ "$#" -gt 0 ] && [ "${1#/}" = "$1" ] && [ -e "$1" ]; then
  document_dir=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd)
  set -- "$document_dir/$(basename -- "$1")"
fi

cd "$app_dir/usr"
exec "$app_dir/usr/bin/kavla-desktop" "$@"
