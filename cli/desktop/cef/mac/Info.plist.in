<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>Kavla</string>
  <key>CFBundleIdentifier</key><string>dev.kavla.desktop</string>
  <key>CFBundleName</key><string>Kavla</string>
  <key>CFBundleDisplayName</key><string>Kavla</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>${KAVLA_BUNDLE_VERSION}</string>
  <key>CFBundleShortVersionString</key><string>${KAVLA_BUNDLE_VERSION}</string>
  <key>LSMinimumSystemVersion</key><string>${CEF_TARGET_SDK}</string>
  <key>NSHighResolutionCapable</key><true/>
